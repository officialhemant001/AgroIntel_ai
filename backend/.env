# AgroIntel Backend Environment Variables
# ⚠️  NEVER commit this file to Git. Copy .env.example and fill in your values.

# Django
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_50_CHAR_STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# DATABASE_URL=postgres://postgres:YOUR_SECURE_PASSWORD@localhost:5432/agrointel
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# API Keys (add your own keys)
OPENWEATHER_API_KEY=
GEMINI_API_KEY=

# Media
MEDIA_URL=/media/